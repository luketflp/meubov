# Copy to .env.local and adjust as needed. Next.js loads .env.local automatically.
#
# Local Postgres from docker-compose (`pnpm db:up`). This is the connection
# string Drizzle will use once it is wired up.
DATABASE_URL="postgresql://meubov:meubov@localhost:5433/meubov"

# Remote environments for the migration CLI (`pnpm migration:deploy:*`,
# `pnpm migration:status <env>`). Leave a variable empty/absent if you should
# NOT be able to run migrations against that environment — the CLI refuses to
# act on an env whose URL is missing.
# DEV_DATABASE_URL=""
# HOMOLOG_DATABASE_URL=""
# PROD_DATABASE_URL=""

# Better Auth.
# Generate a real secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="generate-with-openssl-rand-base64-32"
BETTER_AUTH_URL="http://localhost:3000"
# Google OAuth (optional). Create credentials at https://console.cloud.google.com/
# with the authorized redirect URI http://localhost:3000/api/auth/callback/google.
# Leave empty to disable "Continuar com Google" (email/password still works).
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
